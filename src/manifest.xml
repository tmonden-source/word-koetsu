<?xml version="1.0" encoding="UTF-8"?>
<!--
  manifest.xml — Wordアドインの設定ファイル。
  配布時はこのファイルを各PCのWordに読み込ませる。

  ★ デプロイ後、以下2か所を自分のNetlifyサイトのURLに置き換えること:
     1) <Id> は一意のGUIDに（後述の手順参照）
     2) すべての https://YOUR-SITE-NAME.netlify.app を実際のURLに
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- ▼ 一意のGUIDに置き換える（重複不可）。下記コマンドで生成できる ▼ -->
  <Id>00000000-0000-0000-0000-000000000000</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>あなたの会社名</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="日本語校閲" />
  <Description DefaultValue="誤字脱字を検出し、変更履歴として反映します。" />

  <!-- アドインのアイコン（任意の公開URLでも可） -->
  <IconUrl DefaultValue="https://YOUR-SITE-NAME.netlify.app/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-SITE-NAME.netlify.app/assets/icon-80.png" />

  <!-- このアドインが通信する先のドメイン（許可リスト） -->
  <AppDomains>
    <AppDomain>https://YOUR-SITE-NAME.netlify.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-SITE-NAME.netlify.app/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>

          <!-- リボン（ツールバー）にボタンを追加 -->
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="KoetsuGroup">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="OpenTaskpaneButton">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>KoetsuTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-SITE-NAME.netlify.app/assets/icon-32.png" />
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-SITE-NAME.netlify.app/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-SITE-NAME.netlify.app/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-SITE-NAME.netlify.app/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://YOUR-SITE-NAME.netlify.app/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="日本語校閲を導入しました" />
        <bt:String id="Group.Label" DefaultValue="校閲" />
        <bt:String id="Button.Label" DefaultValue="日本語校閲" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="「校閲」グループの「日本語校閲」ボタンから開始できます。" />
        <bt:String id="Button.Tooltip" DefaultValue="誤字脱字を検出し変更履歴として反映します。" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
